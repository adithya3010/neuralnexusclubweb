// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  slug             String   @id @unique
  title            String
  shortDescription String
  fullDescription  String
  date             String
  time             String
  venue            String
  teamSize         String
  maxTeamSize      Int
  image            String
  status           String
  category         String
  showOnHighlights Boolean  @default(false)
  registrationType String?  @default("website") // 'website' or 'google_form'
  googleFormUrl    String?
  feeType          String   @default("free") // 'free', 'per_person', 'fixed_team', 'tiered'
  feeAmount        Int      @default(0)
  tieredPrices     Json?    // Stores map: {"1": 100, "2": 200, ...}
  password         String?  // Password for event admin login
  whatsappLink     String?
  facultyCoordinatorName  String?
  facultyCoordinatorPhone String?
  studentCoordinatorName  String?
  studentCoordinatorPhone String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
